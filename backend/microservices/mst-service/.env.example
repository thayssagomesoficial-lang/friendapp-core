# MST Service Configuration
PORT=3010
NODE_ENV=development

# Database
DATABASE_URL=postgresql://friendapp:friendapp123@localhost:5432/friendapp
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=friendapp
POSTGRES_USER=friendapp
POSTGRES_PASSWORD=friendapp123

# Firebase (for real-time updates)
FIREBASE_PROJECT_ID=friendapp-core
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# AWS S3 (for media storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=friendapp-mst-media

# Internal Services
ECONOMIA_SERVICE_URL=http://localhost:3008
AURAH_AI_SERVICE_URL=http://localhost:8000

# Rate Limits
RATE_LIMIT_UPLOADS_PER_DAY=10
RATE_LIMIT_WAVES_PER_MINUTE=20

# Content Settings
MAX_VIDEO_DURATION_SECONDS=60
MIN_VIDEO_DURATION_SECONDS=3
MAX_FILE_SIZE_MB=100
